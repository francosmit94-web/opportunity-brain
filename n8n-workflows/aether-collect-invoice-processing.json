        "name": "Webhook",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [
          250,
          300
        ],
        "webhookId": "36d45e81-68e3-4210-9a56-5bbfba01a3ec",
        "parameters": {
          "httpMethod": "POST",
          "path": "invoices/new",
          "responseMode": "responseNode",
          "options": {}
        }
      },
      {
        "id": "d324d83a-554b-4a05-92ee-3937dd1b1cfe",
        "name": "Process Invoice",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          450,
          300
        ],
        "parameters": {
          "language": "javaScript",
          "code": "const d = $json.body || $json;\nconst dueDate = new Date(d.dueDate);\nconst now = new Date();\nconst diffDays = Math.floor((now.getTime() - dueDate.getTime()) / (1000 * 60 * 60 * 24));\nlet category = 'current';\nif (diffDays > 90) category = 'collections';\nelse if (diffDays > 60) category = 'escalated';\nelse if (diffDays > 30) category = 'overdue';\nelse if (diffDays > 0) category = 'pending';\nreturn { json: { invoiceNumber: d.invoiceNumber, clientName: d.clientName, amount: d.amount, daysOverdue: diffDays, category: category, status: 'processed' } };"
        }
      },
      {
        "id": "66cf8a91-c37d-475b-8b2b-17d030c7fa73",
        "name": "Respond",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1,
        "position": [
          650,
          300
        ],
        "parameters": {
          "respondWith": "json",
          "responseBody": "={{ $json }}",
          "options": {
            "responseCode": 200
          }
        }
      }
    ],
    "connections": {
